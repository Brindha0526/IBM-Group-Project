// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  profile   Profile?
  foodLogs  FoodLog[]
  goals     Goal[]
}

model Profile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  path             Path           // BEFORE | AFTER
  // Before-path fields
  budget           String?        // e.g. "low" | "medium" | "high"
  schedule         String?        // e.g. "busy_weekdays"
  cuisines         String[]       // free-text entries; any cuisine is valid — no fixed list
  religiousRules   String[]       // free-text e.g. ["halal", "kosher", "vegan"]
  preferences      String[]       // free-form tags
  allergens        String[]       // from fixed FDA major-9 list
  medications      String[]       // free-text entries; user types any medication name
  medicalHistory   String?        // optional free-text; used to suggest curated goals
  // After-path fields
  careTeamFlags    CareTeamFlag[] // from fixed list in GUIDELINES
  // Sensitive flags (triggers general-only mode)
  isPregnant       Boolean        @default(false)
  hasKidneyDisease Boolean        @default(false)
  takesInsulin     Boolean        @default(false)
  hasEdHistory     Boolean        @default(false)
  hideCalories     Boolean        @default(false)
  // Location — used for dietitian search and grocery store finder
  zipCode          String?        // e.g. "10001" or "SW1A 1AA"
  country          String?        // ISO-3166-1 alpha-2, e.g. "US", "GB"
  // Body metrics — used for BMI + caloric target calculation
  heightCm         Float?         // user-entered height in centimetres
  weightKg         Float?         // user-entered weight in kilograms
  age              Int?           // user-entered age in years
  sex              Sex?           // MALE | FEMALE | OTHER (affects Mifflin-St Jeor constant)
  activityLevel    ActivityLevel? // sedentary → extra_active
  weightGoal       WeightGoal?    // LOSE | MAINTAIN | GAIN
  goalIntensity    GoalIntensity? // intensity of cut/bulk: MODERATE|AGGRESSIVE (cut) or LEAN|STANDARD|AGGRESSIVE (bulk)
  caloricGoalKcal  Int?           // final kcal/day target (user-confirmed or overridden)
}

model Goal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  nutrient  String     // e.g. "iron", "fiber", "sodium"
  targetMin Float?
  targetMax Float?
  unit      String     // e.g. "mg", "g"
  source    GoalSource // see enum below
  label     String?    // optional display name set by user e.g. "Eat more fibre"
  createdAt DateTime   @default(now())
}

model FoodLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  loggedAt     DateTime @default(now())
  fdcId        String   // USDA FoodData Central ID
  foodName     String
  servingG     Float    // grams
  nutrients    Json     // snapshot of USDA nutrient data at log time
  safetyPassed Boolean  // result of runSafetyRules() at log time
}

enum Path {
  BEFORE
  AFTER
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum WeightGoal {
  LOSE
  MAINTAIN
  GAIN
}

enum GoalIntensity {
  MODERATE    // cut: −15% TDEE (~0.3–0.5 kg/week)
  AGGRESSIVE  // cut: −25% TDEE (~0.5–0.8 kg/week) OR bulk: +20% TDEE
  LEAN        // bulk: +10% TDEE (~0.1–0.2 kg/week)
  STANDARD    // bulk: +15% TDEE (~0.2–0.3 kg/week)
}

enum GoalSource {
  GUIDELINES   // derived from Dietary Guidelines for Americans
  CARE_TEAM    // derived from a CareTeamFlag the user selected
  USER_DEFINED // the user typed in their own goal
  CURATED      // system-suggested from medical history text, confirmed by user
}

enum CareTeamFlag {
  LOW_IRON
  LOW_VITAMIN_D
  LOW_B12
  HIGH_CHOLESTEROL
  HIGH_BLOOD_SUGAR
  HIGH_BLOOD_PRESSURE
}
